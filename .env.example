# Copy to .env and fill in. .env is gitignored and never committed.

# --- App ---
# "production" disables the interactive API docs unless ENABLE_API_DOCS=true.
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FORMAT=json          # line-delimited JSON logs for aggregators

# --- Security ---
# Redact credential-shaped values (passwords, API keys, connection strings)
# out of alert telemetry before it is sent to the LLM provider. Only turn this
# off if you have a contractual reason to send raw telemetry — see
# docs/security.md.
LLM_REDACT_TELEMETRY=true
# Reject request bodies larger than this many bytes.
MAX_REQUEST_BYTES=256000
# Serve /docs, /redoc and /openapi.json. Defaults to off when ENVIRONMENT is
# "production", on otherwise.
# ENABLE_API_DOCS=false

# --- LLM analysis engine (required only for AI analysis) ---
# The app boots and the health endpoint works WITHOUT a key.
# LLM_PROVIDER: "openai" = OpenAI, or any OpenAI-compatible server via LLM_BASE_URL.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=            # optional, e.g. http://localhost:11434/v1 (Ollama)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30     # per request
LLM_MAX_RETRIES=2          # retries after the first attempt (0-5)
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_MAX_OUTPUT_TOKENS=1200

# --- OpenAI (embeddings; also a legacy fallback for LLM_API_KEY / LLM_MODEL) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# "local"  = keyless hashing embedder, runs offline (dev/CI default)
# "openai" = semantic embeddings via OpenAI (recommended for production)
EMBEDDING_PROVIDER=local

# --- RAG pipeline (all tunable) ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
# What to do when retrieval breaks (missing corpus, dead embedder, bad index):
#   degrade - analyse from the alert alone, clearly marked and low-confidence
#   fail    - refuse the request with 503 rag_unavailable
RAG_FAILURE_MODE=degrade
RAG_SIMILARITY_THRESHOLD=0.08

# --- Storage ---
# Local (non-Docker) path. docker-compose.yml overrides this with
# sqlite:////app/var/app.db, a writable volume inside the container.
DATABASE_URL=sqlite:///./app.db

# --- Data location (inside the backend container) ---
DATA_DIR=/app/data

# --- CORS: origins allowed to call the API directly (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
