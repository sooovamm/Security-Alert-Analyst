# Copy to .env and fill in. .env is gitignored and never committed.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OpenAI (required only for AI analysis, added in Sprint 3+) ---
# The app boots and the health endpoint works WITHOUT this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# "openai" for production embeddings, "local" for a keyless offline fallback.
EMBEDDING_PROVIDER=openai

# --- Storage ---
DATABASE_URL=sqlite:///./app.db

# --- Data location (inside the backend container) ---
DATA_DIR=/app/data

# --- CORS: origins allowed to call the API directly (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
