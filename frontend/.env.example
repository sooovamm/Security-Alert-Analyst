# Frontend configuration. Copy to .env.local for local overrides (gitignored).
# All values are build-time: Vite inlines them into the bundle, so never put a
# secret here — anything in this file is visible to anyone loading the page.

# Where the browser sends API calls. The default "/api" is same-origin and is
# reverse-proxied to the backend by the Vite dev server and by nginx in
# production, which avoids CORS entirely. Point it at a full URL only when the
# backend is served from another origin.
# VITE_API_BASE_URL=/api

# Request timeouts in milliseconds. Analysis is a live LLM call, so it gets a
# much longer budget than ordinary reads.
# VITE_REQUEST_TIMEOUT_MS=15000
# VITE_ANALYSIS_TIMEOUT_MS=120000

# Dev server only: where `npm run dev` proxies /api to.
# VITE_BACKEND_URL=http://localhost:8000
